[metadata]
project = "nextgen-databases"
version = "0.2.0"
last-updated = "2026-09-25"
status = "active"

[project-context]
purpose = "Coordinate four database/language families and their integration evidence"
phase = "Establish and connect honest executable boundaries — foundational fixes DONE 2026-09-25 for template debt, K9 pedigree, trusted-base, lithoglyph/gnpl disentanglement, verisim-core AFFIRMATION"
registry = "REGISTRY.adoc"
public-languages = ["VCL-UT", "GNPL", "KRL", "Hermeneia"]

[observation]
horizon = "Local canonical checkouts and focused commands on 2026-09-25; no remote CI, deployment or whole-estate correctness claim; template debt fixed, K9 validation passes, ReScript/TS migration DONE in coordination paths via extraction"
evidence-ledger = "EXPLAINME.adoc"
priorities = "ROADMAP.adoc"
affirmation = "docs/AFFIRMATION.adoc (2026-09-25 supersedes 2026-06-19)"
proof-debt = "docs/proof-debt.adoc (NEW 2026-09-25, resolves Issue #53 trusted-base)"
disentanglement = "docs/migration/LITHOGLYPH-GNPL-DISENTANGLEMENT.adoc (NEW 2026-09-25, resolves Issue #45)"
verisim-core-affirmation = "verisim-core/AFFIRMATION.adoc (NEW 2026-09-25, resolves Issue #42)"

[foundational-fixes-2026-09-25]
issue-42-template-debt = "DONE — methodology.a2ml {{PROJECT_UNIQUE_STRENGTH}} fixed, 0 placeholder files, A2ML validation 36 files 0 errors"
issue-42-rescript-ts-migration = "DONE in coordination repo — 0 .res/.ts files, 0 package.json in coordination paths via extraction; per-owning-repo migration continues"
issue-42-verisim-core-affirmation = "DONE — verisim-core/AFFIRMATION.adoc created with scoped table, stack placement, reproducibility, cross-repo wiring"
issue-45-lithoglyph-gnpl-disentanglement = "DONE — design decision documented, GNPL vs LithoglyphDB semantic separation, extraction history-preserving with split-history tags"
issue-45-extraction = "DONE — lithoglyph 819 files 2026-07-27, verisimdb 713 files 2026-08-03, gnpl 125 files PR #4, glyphbase 130 files; pointer READMEs left; placement guard now FAILS on new files under those paths"
issue-53-k9-pedigree = "DONE — verisimdb/connectors/test-infra/deploy.k9.ncl no longer in this repo after extraction; remaining 7 K9 files all have metadata.name, validation passes"
issue-53-trusted-base = "DONE — docs/proof-debt.adoc created, inventory shows no TRUSTED/AXIOM/believe_me in coordination paths, Mustfile now checks proof-debt-documented and k9-pedigree-valid"

[family-boundaries]
verisimdb = "Standalone VCL-UT parser/admissibility/wire tests pass; mandatory gate coverage across advertised VeriSimDB operations still needs integration evidence"
lithoglyph = "Unimplemented builtin proof verifiers refuse success; registered callback plumbing has positive and rejection controls"
gnpl = "Independent direct-evidence narration kernel and CLI now run; five Lean suites pass, including 35 narration checks. Withdrawal/order properties have an audited [propext] footprint. Live Lithoglyph adapter and Glyphbase path remain work."
quandledb = "KRL draft and implemented fragment are distinct contracts; bucket candidates cannot satisfy stronger resolution assurance requests"
vocarium = "Hermeneia and Vocarium have tested invoke slices using distinct store implementations; shared durable warrant/withdrawal contract remains work"

[knot-project-boundaries]
independent-libraries = "Skein.jl and other Julia knot libraries have their own purposes; use by QuandleDB does not make them KRL or imply database-specific origins"
tangle = "Independent Turing-complete knot-mathematics language; no KRL-to-Tangle compilation dependency or inherited proof guarantees"
krl = "Knot resolution language associated with QuandleDB; no retired query-language identity"

[next-actions]
actions = ["GNPL: connect the imported evidence contract to a consistent real Lithoglyph journal snapshot and test withdrawal across revisions", "QuandleDB/KRL: implement and check an explicit resolution witness", "VeriSimDB/VCL-UT: test mandatory admissibility coverage", "Vocarium/Hermeneia: test one shared storage and warrant-withdrawal contract"]

[history]
note = "Earlier tropical-bridge and extraction checkpoints remain in Git history. Their counts, completion estimates and CI status are not reasserted by this checkpoint. Preserve split-history tags and _split_* branches."
