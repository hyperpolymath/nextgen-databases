# RSR-template-repo - Editor Configuration
# https://editorconfig.org

root = true
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
[*.md]
trim_trailing_whitespace = false
[*.adoc]
[*.rs]
indent_size = 4
[*.ex]
[*.exs]
[*.zig]
[*.ada]
indent_size = 3
[*.adb]
[*.ads]
[*.hs]
[*.res]
[*.resi]
[*.ncl]
[*.rkt]
[*.scm]
[*.nix]
[Justfile]
[justfile]
# SPDX-License-Identifier: MPL-2.0
[Makefile]
indent_style = tab
